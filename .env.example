# Copy this file to .env and paste your key. .env is git-ignored and never logged.
#
# Get a Gemini API key at: https://aistudio.google.com/apikey
# (sign in with a Google account, click "Create API key", copy the string that
# starts with "AIza...")
GEMINI_API_KEY=AIza...

# Optional overrides
PM4_MODEL=gemini-3.1-flash-lite
PM4_LOG_SALT=change-me-per-deployment

# n8n escalation form (see n8n/README.md). Overrides handoff.form_url in
# config.yaml. Must be the PRODUCTION URL of an ACTIVE workflow - n8n ignores
# query-parameter prefill on the test URL, silently.
PM4_HANDOFF_FORM_URL=http://localhost:5678/form/pm4-eskalation
